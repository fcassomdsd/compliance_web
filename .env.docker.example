# compliance_web — Docker environment template. Copy to .env and replace every
# value marked change-me.
#
# ---------------------------------------------------------------------------
# Secrets do not have to live in this file.
#
# AUTH_TICKET_ENCRYPTION_KEY, DATABASE_URL, NODE_RED_API_KEY,
# ALFRESCO_JOB_PASSWORD and SMTP_PASS each resolve by precedence
# (see server/config/secrets.cjs):
#
#   1. <NAME>_FILE          a path to a file holding the value
#   2. /run/secrets/<name>  a Docker/Compose secret, lowercase name
#   3. <NAME>               this file / a plain environment variable
#
# So AUTH_TICKET_ENCRYPTION_KEY_FILE=/run/secrets/auth_ticket_encryption_key
# works in place of setting the value here. That is the seam a secret manager
# writes into — nothing here changes when one is introduced.
#
# If <NAME>_FILE is set and the file is missing or empty, startup fails rather
# than quietly falling back to the environment variable: a silent fallback is
# how a failed secret rotation looks like a successful one.
#
# With NODE_ENV=production the server also refuses any value published in this
# repository — including the three change-me values below and the shared demo
# gateway key. Setting a variable is not the same as securing it.
# ---------------------------------------------------------------------------

POSTGRES_DB=compliance
POSTGRES_USER=compliance
POSTGRES_PASSWORD=change-me

# Backend auth settings
ALFRESCO_BASE_URL=http://host.docker.internal:8080

# Required. docker compose refuses to start without it, and the server refuses to
# start in production without it. Generate a long random value and keep it secret.
AUTH_TICKET_ENCRYPTION_KEY=change-me-for-non-dev

# Secure by default: production mode plus secure (HTTPS-only) session cookies.
# For local HTTP development only, uncomment the two overrides below.
AUTH_NODE_ENV=production
AUTH_COOKIE_SECURE=true
# AUTH_NODE_ENV=development
# AUTH_COOKIE_SECURE=false

# Shared secret expected by Node-RED's X-API-Key gateway guard. Must match
# API_KEY in the compliance_flow deployment (and IMPORT_API_KEY in compliance_import's).
# The value below is a PUBLIC PLACEHOLDER, committed to this repo — change it, together
# with the matching values in the other two services, before any deployment reachable
# by anyone you do not trust. Leave empty only in development.
NODE_RED_API_KEY=demo-only-CHANGE-BEFORE-ANY-PUBLIC-DEPLOYMENT

# Service account used by the scheduled jobs (overdue findings, site-visit
# scheduling) and by role-addressed notifications, which read Alfresco group
# membership to find who holds a role. Create this user in Alfresco; it needs to
# be able to read groups and people (GET /groups/{id}/members and
# GET /people/{id}). Without it both jobs log "skipped" at startup and every role
# notification falls back to the fixed distribution lists below.
ALFRESCO_JOB_USERNAME=
ALFRESCO_JOB_PASSWORD=

# How long the role -> users lookup is cached, in ms (default 15 minutes, the
# same interval the session role cache uses).
# ROLE_RECIPIENT_CACHE_MS=900000

# Hour of the day each daily job runs, as a plain integer 0-23, in the
# container's timezone (UTC unless the image is given another one). Defaults:
# 1 for the overdue-finding sweep, 2 for site-visit scheduling.
#
# The scheduler only rolls forward: if the hour has already passed when the
# process starts, the first run is that hour tomorrow. To make a job run soon,
# set an hour still ahead of the container clock and restart the service.
# FINDING_OVERDUE_JOB_HOUR=1
# SITE_VISIT_SCHEDULING_JOB_HOUR=2

# Days of planning notice a recurring cadence gets before its due date, when the
# cadence itself names none (InspectionCadence.planningLeadDays). The site visit
# is created that many days ahead and carries the due date as its start date.
# Default 20.
# SITE_VISIT_PLANNING_LEAD_DAYS=20

# Email delivery for notifications. Without SMTP_HOST the transport is not
# configured: email notifications queue and fail, while the in-app notifications
# a role notification also creates are unaffected (they need no transport).
SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Fallback addresses for role-addressed notifications, used when the role
# resolves to nobody, the lookup fails, or no service account is configured.
# CASE_ESCALATION_EMAIL has no role behind it by design: the BPMN routes a missed
# deadline to "Solución de Casos de Seguridad", a safety-case team that is not
# one of this application's roles, so it is always a distribution list.
INSPECTOR_NOTIFICATIONS_EMAIL=
CAP_ENTRY_NOTIFICATIONS_EMAIL=
PLANNER_NOTIFICATIONS_EMAIL=
CASE_ESCALATION_EMAIL=

# Optional image target overrides (advanced)
# BACKEND_BUILD_TARGET=dev

# ---------------------------------------------------------------------------
# BIND_IP — which host interface published ports listen on.
#
# Default 0.0.0.0 (all interfaces) keeps the demo and CI working: the
# quickstart and demo-verify-ci.sh reach services over the network, and under
# dind DEMO_HOST is `docker`, not localhost, so a hardcoded loopback bind
# would break the whole-stack guard.
#
# A production deployment sets BIND_IP=127.0.0.1 so every service is reachable
# only from the host itself, and the single TLS edge (compliance_web's
# frontend-tls, host 443) is the only externally published port. See
# "An ideal production configuration.md" section 2.3.
BIND_IP=0.0.0.0
